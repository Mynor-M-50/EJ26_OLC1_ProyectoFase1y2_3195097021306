package com.golite.parser;

import java_cup.runtime.*;
import com.golite.ast.NodoAST;
import com.golite.ast.sentencias.*;
import com.golite.ast.expresiones.*;
import java.util.ArrayList;
import java.util.List;

parser code {:
    public void syntax_error(java_cup.runtime.Symbol s) {
        String val = s.value != null ? s.value.toString() : "desconocido";
        String msg = "Error sintactico cerca de '" + val + "'";
        com.golite.interpreter.Interprete.getInstancia()
            .agregarError(msg, s.left, s.right, "sintactico");
    }

    public void unrecovered_syntax_error(java_cup.runtime.Symbol s) {
        String val = s.value != null ? s.value.toString() : "desconocido";
        String msg = "Error sintactico no recuperable cerca de '" + val + "'";
        com.golite.interpreter.Interprete.getInstancia()
            .agregarError(msg, s.left, s.right, "sintactico");
    }

    public void report_error(String message, Object info) { }
    public void report_fatal_error(String message, Object info) { }
:};

terminal VAR, FUNC, MAIN, IF, ELSE, FOR, BREAK, CONTINUE, RETURN;
terminal SWITCH, CASE, DEFAULT;
terminal NIL, UMINUS;
terminal TINT, TFLOAT64, TSTRING, TBOOL, TRUNE;
terminal PRINTLN, ATOI, PARSEFLOAT, TYPEOF;
terminal PLUS, MINUS, TIMES, DIV, MOD, INC, DEC;
terminal ASSIGN, DECL_ASSIGN, PLUS_ASSIGN, MINUS_ASSIGN;
terminal EQ, NEQ, LT, GT, LEQ, GEQ;
terminal AND, OR, NOT;
terminal LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET;
terminal COMMA, SEMICOLON, DOT, COLON;
terminal String      ID, STRING_LIT;
terminal Integer     INT_LIT;
terminal Double      FLOAT_LIT;
terminal Boolean     TRUE, FALSE;
terminal Character   RUNE_LIT;

non terminal NodoPrograma        program;
non terminal List                func_list;
non terminal NodoAST             func_decl;
non terminal List                param_list;
non terminal List                params;
non terminal Object[]            param;
non terminal List                stmt_list;
non terminal NodoAST             stmt;
non terminal NodoAST             expr;
non terminal List                expr_list;
non terminal String              tipo;
non terminal NodoAST             decl_stmt;
non terminal NodoAsignacion      assign_stmt;
non terminal NodoIf              if_stmt;
non terminal NodoAST             for_stmt;
non terminal NodoAST             print_stmt;
non terminal String              opt_semi;
non terminal NodoAST             switch_stmt;
non terminal List                case_list;
non terminal NodoAST             case_clause;

precedence left OR;
precedence left AND;
precedence left EQ, NEQ;
precedence left LT, GT, LEQ, GEQ;
precedence left PLUS, MINUS;
precedence left TIMES, DIV, MOD;
precedence right NOT, UMINUS;

start with program;

program ::= func_list:fl FUNC MAIN LPAREN RPAREN LBRACE stmt_list:s RBRACE
            {: RESULT = new NodoPrograma((List)fl, (List)s); :}
          | FUNC MAIN LPAREN RPAREN LBRACE stmt_list:s RBRACE
            {: RESULT = new NodoPrograma(new ArrayList(), (List)s); :}
          ;

func_list ::= func_list:fl func_decl:f
              {: ((List)fl).add(f); RESULT = fl; :}
            | func_decl:f
              {: List l = new ArrayList(); l.add(f); RESULT = l; :}
            ;

func_decl ::= FUNC ID:n LPAREN param_list:p RPAREN tipo:t LBRACE stmt_list:s RBRACE
              {: RESULT = new NodoFuncion(n, (List)p, t, (List)s, nleft, nright); :}
            | FUNC ID:n LPAREN param_list:p RPAREN LBRACE stmt_list:s RBRACE
              {: RESULT = new NodoFuncion(n, (List)p, null, (List)s, nleft, nright); :}
            ;

param_list ::= params:p  {: RESULT = p; :}
             |            {: RESULT = new ArrayList(); :}
             ;

params ::= params:ps COMMA param:p
           {: ((List)ps).add(p); RESULT = ps; :}
         | param:p
           {: List l = new ArrayList(); l.add(p); RESULT = l; :}
         ;

param ::= ID:n tipo:t
          {: RESULT = new Object[]{n, t}; :}
        ;

stmt_list ::= stmt_list:sl stmt:s
              {: if (s != null) { ((List)sl).add(s); } RESULT = sl; :}
            | stmt_list:sl error SEMICOLON
              {: RESULT = sl; :}
            | stmt_list:sl error RBRACE
              {: RESULT = sl; :}
            |
              {: RESULT = new ArrayList(); :}
            ;

opt_semi ::= SEMICOLON | ;

stmt ::= decl_stmt:d   opt_semi  {: RESULT = d; :}
       | assign_stmt:a opt_semi  {: RESULT = a; :}
       | if_stmt:i               {: RESULT = i; :}
       | for_stmt:f              {: RESULT = f; :}
       | print_stmt:p  opt_semi  {: RESULT = p; :}
       | switch_stmt:s           {: RESULT = s; :}
       | BREAK:b        opt_semi {: RESULT = new NodoBreak(bleft, bright); :}
       | CONTINUE:c     opt_semi {: RESULT = new NodoContinue(cleft, cright); :}
       | RETURN:r expr:e SEMICOLON {: RESULT = new NodoReturn(e, rleft, rright); :}
       | RETURN:r expr:e           {: RESULT = new NodoReturn(e, rleft, rright); :}
       | RETURN:r SEMICOLON        {: RESULT = new NodoReturn(null, rleft, rright); :}
       | ID:n LPAREN expr_list:a RPAREN SEMICOLON
         {: RESULT = new NodoLlamada(n, (List)a, nleft, nright); :}
       | ID:n LPAREN expr_list:a RPAREN
         {: RESULT = new NodoLlamada(n, (List)a, nleft, nright); :}
       | ID:n LPAREN RPAREN SEMICOLON
         {: RESULT = new NodoLlamada(n, new ArrayList(), nleft, nright); :}
       | ID:n LPAREN RPAREN
         {: RESULT = new NodoLlamada(n, new ArrayList(), nleft, nright); :}
       | LBRACE stmt_list:sl RBRACE
         {: RESULT = new NodoBloque((List)sl, 0, 0); :}
       ;

decl_stmt ::= VAR ID:n tipo:t ASSIGN expr:e
              {: RESULT = new NodoDeclaracion(n, t, e, nleft, nright); :}
            | VAR ID:n tipo:t
              {: RESULT = new NodoDeclaracion(n, t, null, nleft, nright); :}
            | ID:n DECL_ASSIGN expr:e
              {: RESULT = new NodoDeclaracion(n, null, e, nleft, nright); :}
            ;

tipo ::= TINT      {: RESULT = "int"; :}
       | TFLOAT64  {: RESULT = "float64"; :}
       | TSTRING   {: RESULT = "string"; :}
       | TBOOL     {: RESULT = "bool"; :}
       | TRUNE     {: RESULT = "rune"; :}
       ;

assign_stmt ::= ID:n ASSIGN expr:e
                {: RESULT = new NodoAsignacion(n, "=", e, nleft, nright); :}
              | ID:n PLUS_ASSIGN expr:e
                {: RESULT = new NodoAsignacion(n, "+=", e, nleft, nright); :}
              | ID:n MINUS_ASSIGN expr:e
                {: RESULT = new NodoAsignacion(n, "-=", e, nleft, nright); :}
              | ID:n INC
                {: RESULT = new NodoAsignacion(n, "+=", new NodoEntero(1, nleft, nright), nleft, nright); :}
              | ID:n DEC
                {: RESULT = new NodoAsignacion(n, "-=", new NodoEntero(1, nleft, nright), nleft, nright); :}
              ;

if_stmt ::= IF expr:c LBRACE stmt_list:t RBRACE
            {: RESULT = new NodoIf(c, (List)t, null, null, cleft, cright); :}
          | IF expr:c LBRACE stmt_list:t RBRACE ELSE LBRACE stmt_list:e RBRACE
            {: RESULT = new NodoIf(c, (List)t, (List)e, null, cleft, cright); :}
          | IF expr:c LBRACE stmt_list:t RBRACE ELSE if_stmt:ei
            {: RESULT = new NodoIf(c, (List)t, null, ei, cleft, cright); :}
          ;

for_stmt ::= FOR expr:c LBRACE stmt_list:b RBRACE
             {: RESULT = new NodoFor(c, null, null, (List)b, cleft, cright); :}
           | FOR decl_stmt:i SEMICOLON expr:c SEMICOLON assign_stmt:u LBRACE stmt_list:b RBRACE
             {: RESULT = new NodoFor(c, i, u, (List)b, cleft, cright); :}
           ;

print_stmt ::= PRINTLN:p LPAREN expr_list:args RPAREN
               {: RESULT = new NodoPrintln((List)args, pleft, pright); :}
             | PRINTLN:p LPAREN RPAREN
               {: RESULT = new NodoPrintln(new ArrayList(), pleft, pright); :}
             ;

switch_stmt ::= SWITCH:s expr:e LBRACE case_list:cl RBRACE
                {: RESULT = new NodoSwitch(e, (List)cl, null, sleft, sright); :}
              | SWITCH:s expr:e LBRACE case_list:cl DEFAULT COLON stmt_list:dl RBRACE
                {: RESULT = new NodoSwitch(e, (List)cl, (List)dl, sleft, sright); :}
              ;

case_list ::= case_list:cl case_clause:c
              {: ((List)cl).add(c); RESULT = cl; :}
            |
              {: RESULT = new ArrayList(); :}
            ;

case_clause ::= CASE:c expr:e COLON stmt_list:sl
                {: RESULT = new NodoCaso(e, (List)sl, cleft, cright); :}
              ;

expr_list ::= expr_list:el COMMA expr:e
              {: ((List)el).add(e); RESULT = el; :}
            | expr:e
              {: List l = new ArrayList(); l.add(e); RESULT = l; :}
            ;

expr ::= expr:a PLUS   expr:b  {: RESULT = new NodoSuma(a, b, aleft, aright); :}
       | expr:a MINUS  expr:b  {: RESULT = new NodoResta(a, b, aleft, aright); :}
       | expr:a TIMES  expr:b  {: RESULT = new NodoMultiplicacion(a, b, aleft, aright); :}
       | expr:a DIV    expr:b  {: RESULT = new NodoDivision(a, b, aleft, aright); :}
       | expr:a MOD    expr:b  {: RESULT = new NodoModulo(a, b, aleft, aright); :}
       | expr:a EQ     expr:b  {: RESULT = new NodoComparacion(a, "==", b, aleft, aright); :}
       | expr:a NEQ    expr:b  {: RESULT = new NodoComparacion(a, "!=", b, aleft, aright); :}
       | expr:a LT     expr:b  {: RESULT = new NodoComparacion(a, "<",  b, aleft, aright); :}
       | expr:a GT     expr:b  {: RESULT = new NodoComparacion(a, ">",  b, aleft, aright); :}
       | expr:a LEQ    expr:b  {: RESULT = new NodoComparacion(a, "<=", b, aleft, aright); :}
       | expr:a GEQ    expr:b  {: RESULT = new NodoComparacion(a, ">=", b, aleft, aright); :}
       | expr:a AND    expr:b  {: RESULT = new NodoLogico(a, "&&", b, aleft, aright); :}
       | expr:a OR     expr:b  {: RESULT = new NodoLogico(a, "||", b, aleft, aright); :}
       | NOT expr:a            {: RESULT = new NodoLogico(a, "!", null, aleft, aright); :}
       | MINUS expr:a          {: RESULT = new NodoNegacion(a, aleft, aright); :} %prec UMINUS
       | LPAREN expr:e RPAREN  {: RESULT = e; :}
       | INT_LIT:v             {: RESULT = new NodoEntero(v, vleft, vright); :}
       | FLOAT_LIT:v           {: RESULT = new NodoDecimal(v, vleft, vright); :}
       | STRING_LIT:v          {: RESULT = new NodoString(v, vleft, vright); :}
       | TRUE:v                {: RESULT = new NodoBooleano(true,  vleft, vright); :}
       | FALSE:v               {: RESULT = new NodoBooleano(false, vleft, vright); :}
       | NIL:v                 {: RESULT = new NodoEntero(0, vleft, vright); :}
       | RUNE_LIT:v            {: RESULT = new NodoRune(v, vleft, vright); :}
       | ID:v                  {: RESULT = new NodoIdentificador(v, vleft, vright); :}
       | ATOI:p LPAREN expr:e RPAREN
         {: RESULT = new NodoAtoi(e, pleft, pright); :}
       | PARSEFLOAT:p LPAREN expr:e RPAREN
         {: RESULT = new NodoParseFloat(e, pleft, pright); :}
       | TYPEOF:p LPAREN expr:e RPAREN DOT ID LPAREN RPAREN
         {: RESULT = new NodoTypeOf(e, pleft, pright); :}
       | TYPEOF:p LPAREN expr:e RPAREN
         {: RESULT = new NodoTypeOf(e, pleft, pright); :}
       | ID:n LPAREN expr_list:a RPAREN
         {: RESULT = new NodoLlamada(n, (List)a, nleft, nright); :}
       | ID:n LPAREN RPAREN
         {: RESULT = new NodoLlamada(n, new ArrayList(), nleft, nright); :}
       ;